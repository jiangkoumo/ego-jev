#!/usr/bin/env bash
# ego-jev —— 历史入口（兼容垫片）。本项目已改名为 ego-decision-layer。
# 保留它只为不打断 ~/.local/bin/ego-jev 与用户既有脚本：打印一行提示后 exec 新 CLI。
# 这是允许出现旧名的地方之一（见 bench/test-release-consistency.mjs 的白名单）。
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
NEW="$SCRIPT_DIR/ego-decision-layer"
[ -f "$NEW" ] || NEW="$SCRIPT_DIR/../scripts/ego-decision-layer"

printf 'ego-jev 已改名为 ego-decision-layer，本入口保留兼容（自动转发）。\n' >&2
printf '建议改用: ego-decision-layer %s\n' "$*" >&2
exec bash "$NEW" "$@"
