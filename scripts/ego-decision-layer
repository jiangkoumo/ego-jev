#!/usr/bin/env bash
# ego-decision-layer — drive the ego lite browser with Jev (TypeSafe System One) decisions.
set -euo pipefail

# Resolve the real location of this script (works through symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# 引擎查找顺序：显式指定 → 同目录（本仓库布局）→ 仓库根 → 用户级 lib
if [ -n "${EGO_JEV_LIB:-}" ]; then
  LIB="$EGO_JEV_LIB"
else
  LIB=""
  for candidate in "$SCRIPT_DIR/decider-loop.mjs" "$SCRIPT_DIR/../decider-loop.mjs" "$HOME/.agents/lib/decider-loop.mjs"; do
    if [ -f "$candidate" ]; then LIB="$candidate"; break; fi
  done
  LIB="${LIB:-$SCRIPT_DIR/decider-loop.mjs}"
fi
CONFIG_FILE="${TYPESAFE_API_KEY_FILE:-$HOME/.config/typesafe/api_key}"
EGO_BIN="${EGO_BROWSER_BIN:-ego-browser}"

USAGE() {
  cat <<'TXT'
用法: ego-decision-layer [选项] <目标描述>

示例:
  ego-decision-layer --url "https://example.com" "点击登录按钮并聚焦输入框"
  ego-decision-layer --url "https://en.wikipedia.org/wiki/Main_Page" --until "/wiki/Jev" \
    --text "Jev" "在顶部搜索框输入并提交"
  ego-decision-layer --space 3 --keep-space --steps 15 "点击未发送帖子并保存"

选项:
  --url <url>        先导航到的网址
  --space <id>       复用已有 taskSpace（默认新建，不会抢占用户的 space）
  --text <value>     可填入的候选文本，可重复传入；Jev 只能从中选择，不生成文本
  --steps <number>   最大步数（默认 10）
  --until <substr>   页面 URL 包含该子串时立即判成功（推荐，确定性退出条件）
  --keep <a,b>       完成后保留的页面标签，如 p1,p2（默认全部关闭）
  --keep-space       完成后不关闭 taskSpace，便于人工接手检查
  --api-key <key>    直接传入 Jev API Key
  --decider <kind>   决策后端：systemone（默认）| openai-compatible（本地 /v1/chat/completions）
  --base-url <url>   覆盖后端地址（openai-compatible 传端点根，如 http://127.0.0.1:11434/v1）
  --model <name>     覆盖模型名（默认 jev-latest）
  --route-status     只读打印路由状态 JSON（接管情况 / always-on / 官方技能路径），
                     不起浏览器、不需要凭证
  --help, -h         显示帮助

环境变量:
  TYPESAFE_API_KEY_FILE      Jev 凭证文件（默认 ~/.config/typesafe/api_key）
  TYPESAFE_FALLBACK_BASE_URL 主后端失败时的降级端点（不设则不降级）
  TYPESAFE_TEXT_MODEL_FILE   文本生成配置（默认 ~/.config/typesafe/text_model.json）
  EGO_JEV_LIB                引擎路径（默认按 同目录/仓库根/用户级 lib 依次查找）
  EGO_BROWSER_BIN            ego-browser 可执行文件（默认 PATH 里的 ego-browser）
  EGO_JEV_NO_WIRE            设为非空则不做首跑接管 / 自愈（EGO_JEV_NO_HEAL 是旧名，仍接受）
  EGO_JEV_NO_HEAL            同上（旧名）
  EGO_JEV_CONFIG_DIR         路由层启用标记 / always-on 记录目录（历史名，保留；默认 ~/.config/ego-decision-layer）

退出码:
  0 目标达成 (check_passed / jev_done)
  1 未达成 (blocked / no_progress / stuck / target_missing / no_targets /
    text_model_failed / no_text_source / action_failed / max_steps_reached)
  2 参数错误    3 缺少 Jev 凭证

注意:
  * ego-browser 内嵌运行时不会继承 shell 环境变量，所以凭证必须落盘成文件。
  * 决策后端（默认 System One）也走文件式配置：~/.config/ego-decision-layer/decider.json，
    字段 kind/baseUrl/model/apiKey/apiKeyFile/timeoutMs/headers。kind=openai-compatible
    时指向本地端点（llama.cpp / ollama / vLLM / LM Studio），不需要 TypeSafe 凭证；
    文本 LLM 没有校准置信度，引擎会跳过置信度阈值判断，但保留全部执行层护栏。
  * --until 不要用会被浏览器自动翻译改写的 UI 字符串做比较，建议比对 URL 路径或 DOM 状态。
  * 跑任务前会看一眼官方 ego-browser 入口：接管过就静默重接管（ego lite 升级会把它还原）；
    没接管过但检测到入口，就首跑接管一次并打印一行；都没有则什么都不做。
    EGO_JEV_NO_WIRE=1（或旧名 EGO_JEV_NO_HEAL=1）关闭这步。
TXT
}

# 路由层首跑接管 / 自愈：已启用则静默刷新；未启用但检测到官方入口则首跑接管一次并打印一行；
# 都没有则什么都不做。任何失败只降级为一行提示，绝不影响任务本身（退出码不变）。
heal_skill_entry() {
  [ -n "${EGO_JEV_NO_WIRE:-}" ] && return 0
  [ -n "${EGO_JEV_NO_HEAL:-}" ] && return 0   # 旧名，仍接受
  local wire out
  wire="$SCRIPT_DIR/wire-agent-skills.sh"
  [ -f "$wire" ] || wire="$SCRIPT_DIR/../scripts/wire-agent-skills.sh"
  [ -f "$wire" ] || return 0
  out="$(bash "$wire" --ensure 2>&1)" || true
  case "$out" in
    *"已首跑接管"*)
      printf '[ego-decision-layer] 首次运行：已接管官方 ego-browser 入口，多步浏览器任务默认走 ego-decision-layer；还原：bash %s --restore\n' "$wire" >&2 ;;
    *"已接管:"*|*"已刷新:"*|*"已重建入口:"*)
      printf '[ego-decision-layer] 官方 ego-browser 入口被 ego lite 升级还原了，已自动重接管；EGO_JEV_NO_WIRE=1 可关掉这步\n' >&2 ;;
  esac
  return 0
}

# 路由状态（只读、纯 shell，不起浏览器、不要凭证）；失败降级为 null，绝不影响任务
write_route_status() {  # <out-file>
  local out="$1" wire
  wire="$SCRIPT_DIR/wire-agent-skills.sh"
  [ -f "$wire" ] || wire="$SCRIPT_DIR/../scripts/wire-agent-skills.sh"
  if [ -f "$wire" ] && bash "$wire" --status-json > "$out" 2>/dev/null; then return 0; fi
  printf 'null\n' > "$out"
}

TARGET_URL=""; SPACE_ID=""; MAX_STEPS="10"; UNTIL=""; KEEP=""; KEEP_SPACE="0"; API_KEY_OVERRIDE=""; GOAL=""; TEXTS=(); ROUTE_STATUS=0
DECIDER_KIND=""; DECIDER_BASE_URL=""; DECIDER_MODEL=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --url) TARGET_URL="$2"; shift 2 ;;
    --space) SPACE_ID="$2"; shift 2 ;;
    --steps) MAX_STEPS="$2"; shift 2 ;;
    --until) UNTIL="$2"; shift 2 ;;
    --keep) KEEP="$2"; shift 2 ;;
    --keep-space) KEEP_SPACE="1"; shift ;;
    --api-key) API_KEY_OVERRIDE="$2"; shift 2 ;;
    --decider) DECIDER_KIND="$2"; shift 2 ;;
    --base-url) DECIDER_BASE_URL="$2"; shift 2 ;;
    --model) DECIDER_MODEL="$2"; shift 2 ;;
    --route-status) ROUTE_STATUS=1; shift ;;
    --text) TEXTS+=("$2"); shift 2 ;;
    -h|--help) USAGE; exit 0 ;;
    --) shift; GOAL="${GOAL:+$GOAL }$*"; break ;;
    -*) echo "错误: 未知选项 $1" >&2; USAGE >&2; exit 2 ;;
    *) GOAL="${GOAL:+$GOAL }$1"; shift ;;
  esac
done

# --route-status：只读状态，不要求目标 / 凭证 / 浏览器
if [[ "$ROUTE_STATUS" == "1" ]]; then
  ROUTE_WIRE="$SCRIPT_DIR/wire-agent-skills.sh"
  [ -f "$ROUTE_WIRE" ] || ROUTE_WIRE="$SCRIPT_DIR/../scripts/wire-agent-skills.sh"
  [ -f "$ROUTE_WIRE" ] || { echo "错误: 找不到 wire-agent-skills.sh" >&2; exit 2; }
  exec bash "$ROUTE_WIRE" --status-json
fi

if [[ -z "$GOAL" ]]; then echo "错误: 请提供目标描述" >&2; exit 2; fi
case "$DECIDER_KIND" in
  ""|systemone|openai-compatible) ;;
  *) echo "错误: --decider 只支持 systemone / openai-compatible（得到 ${DECIDER_KIND}）" >&2; exit 2 ;;
esac
if [[ ! -f "$LIB" ]]; then echo "错误: 找不到引擎 ${LIB}（可用 EGO_JEV_LIB 指定）" >&2; exit 2; fi
if [[ -z "$API_KEY_OVERRIDE" ]]; then
  # 本地 OpenAI 兼容后端不需要 TypeSafe 凭证：--decider 显式指定，或 decider.json 已配置
  if ! EGO_JEV_LIB_CHECK="$LIB" JEV_DECIDER_KIND="$DECIDER_KIND" node --input-type=module -e \
      'const m = await import(process.env.EGO_JEV_LIB_CHECK); const local = process.env.JEV_DECIDER_KIND === "openai-compatible" || m.loadDeciderConfig()?.kind === "openai-compatible"; process.exit(m.loadApiKey() || local ? 0 : 1);' >/dev/null 2>&1; then
    echo "错误: 未找到 Jev 凭证。写入 ${CONFIG_FILE}（一行 API Key），或在 ~/.config/ego-decision-layer/credentials 写 export TYPESAFE_API_KEY=…，或用 --api-key；用本地后端请配 ~/.config/ego-decision-layer/decider.json 或加 --decider openai-compatible。" >&2
    exit 3
  fi
fi
command -v "$EGO_BIN" >/dev/null 2>&1 || { echo "错误: 找不到 ${EGO_BIN}（ego lite 是否已安装？）" >&2; exit 2; }

# 参数与凭证都合法后才动手（错误路径不写盘）
heal_skill_entry

TMPD="$(mktemp -d "${TMPDIR:-/tmp}/ego-decision-layer.XXXXXX")"
trap 'rm -rf "$TMPD"' EXIT

# 路由状态（只读，不起浏览器）：作为 route 段写进结果 JSON，也进 renderJevSummary
ROUTE_JSON="$TMPD/route.json"
write_route_status "$ROUTE_JSON"

# 用 node 生成 JSON，避免 shell 转义问题（goal 里的引号/换行/$ 都安全）
JEV_GOAL="$GOAL" JEV_URL="$TARGET_URL" JEV_UNTIL="$UNTIL" JEV_KEEP="$KEEP" \
JEV_STEPS="$MAX_STEPS" JEV_KEY="$API_KEY_OVERRIDE" JEV_SPACE="$SPACE_ID" \
JEV_KEEP_SPACE="$KEEP_SPACE" JEV_CONFIG_OUT="$TMPD/config.json" \
JEV_BASE_URL="${TYPESAFE_BASE_URL:-}" JEV_FALLBACK_BASE_URL="${TYPESAFE_FALLBACK_BASE_URL:-}" \
JEV_DECIDER_KIND="$DECIDER_KIND" JEV_DECIDER_BASE_URL="$DECIDER_BASE_URL" JEV_DECIDER_MODEL="$DECIDER_MODEL" \
JEV_ROUTE_FILE="$ROUTE_JSON" \
node -e '
  const fs = require("node:fs");
  fs.writeFileSync(process.env.JEV_CONFIG_OUT, JSON.stringify({
    goal: process.env.JEV_GOAL,
    url: process.env.JEV_URL || null,
    until: process.env.JEV_UNTIL || null,
    keep: process.env.JEV_KEEP || null,
    steps: Number(process.env.JEV_STEPS),
    spaceId: process.env.JEV_SPACE || null,
    keepSpace: process.env.JEV_KEEP_SPACE === "1",
    apiKey: process.env.JEV_KEY || null,
    // ego 运行时拿不到父进程环境变量，后端地址必须在父进程读好、写进配置再送进去
    baseUrl: process.env.JEV_BASE_URL || null,
    fallbackBaseUrl: process.env.JEV_FALLBACK_BASE_URL || null,
    // 决策后端覆盖（--decider/--base-url/--model）；空则交给引擎读 decider.json 或默认 System One
    deciderConfig: (process.env.JEV_DECIDER_KIND || process.env.JEV_DECIDER_BASE_URL || process.env.JEV_DECIDER_MODEL)
      ? {
          kind: process.env.JEV_DECIDER_KIND || undefined,
          baseUrl: process.env.JEV_DECIDER_BASE_URL || undefined,
          model: process.env.JEV_DECIDER_MODEL || undefined,
        }
      : null,
    routeFile: process.env.JEV_ROUTE_FILE || null,
    texts: process.argv.slice(1),
  }, null, 2));
' "${TEXTS[@]+"${TEXTS[@]}"}"

CFG="$TMPD/config.json"

"$EGO_BIN" nodejs <<EOF
const { readFile } = await import("node:fs/promises");
const { runJevAutonomousLoop, renderJevSummary } = await import("$LIB");

const cfg = JSON.parse(await readFile("$CFG", "utf8"));
const startedAt = Date.now();

// 路由状态（父进程只读算好的；失败就是 null，绝不影响任务）
let route = null;
try { if (cfg.routeFile) route = JSON.parse(await readFile(cfg.routeFile, "utf8")); } catch { route = null; }

let task;
if (cfg.spaceId) {
  const id = Number(cfg.spaceId);
  try { task = await takeOverTaskSpace(id); } catch { task = await claimTaskSpace(id); }
} else {
  task = await taskSpace("ego-decision-layer");
}
console.log("TaskSpace " + task.spaceId + " | ownership: " + task.ownership);

let page;
if (cfg.spaceId) {
  const tabs = await task.tabs();
  const active = tabs.find((t) => t.active) || tabs[0];
  page = active && active.label ? task.page(active.label) : active ? await task.adopt(active.page) : task.page("p1");
} else {
  page = task.page("p1");
}

if (cfg.url) {
  console.log("导航至: " + cfg.url);
  await page.goto(cfg.url, { waitUntil: "domcontentloaded", timeout: 25000 });
  await page.waitForTimeout(800);
}

const result = await runJevAutonomousLoop(page, cfg.goal, {
  maxSteps: cfg.steps,
  text: cfg.texts,
  apiKey: cfg.apiKey || undefined,
  baseUrl: cfg.baseUrl || undefined,
  fallbackBaseUrl: cfg.fallbackBaseUrl || undefined,
  deciderConfig: cfg.deciderConfig || undefined,
  check: cfg.until ? async (p) => (await p.url()).includes(cfg.until) : undefined,
});

result.route = route;
console.log(renderJevSummary(result));
console.log(JSON.stringify({
  success: result.success, reason: result.reason, steps: result.steps,
  elapsedMs: Date.now() - startedAt, url: await page.url(), title: await page.title(),
  spaceId: task.spaceId,
  phases: result.phases, serverModels: result.serverModels, usage: result.usage,
  serverEndpoints: result.serverEndpoints,
  route,
}, null, 2));

if (result.success && !cfg.keepSpace) {
  const keep = cfg.keep ? cfg.keep.split(",").map((s) => s.trim()).filter(Boolean) : [];
  const receipt = await task.finish({ keep });
  console.log("已关闭 TaskSpace，保留页面: " + JSON.stringify(receipt.retained || []));
} else if (result.success) {
  console.log("按要求保留 TaskSpace " + task.spaceId + "，可手工检查。");
} else {
  console.log("任务未成功，已保留 TaskSpace " + task.spaceId + " 供排查（未调用 finish）。");
}
process.exitCode = result.success ? 0 : 1;
EOF
